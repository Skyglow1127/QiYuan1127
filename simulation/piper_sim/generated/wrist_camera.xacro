        <camera name="wrist_camera">
          <horizontal_fov>1.5707963267948966</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.01</near>
            <far>4.0</far>
